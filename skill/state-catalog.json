{
  "schema_version": 1,
  "state_schema_version": 5,
  "state_directory": ".claw",
  "init_statuses": [
    "not_started",
    "in_progress",
    "awaiting_confirmation",
    "complete",
    "needs_review"
  ],
  "initialization_statuses": [
    "in_progress",
    "ready",
    "needs_review"
  ],
  "project_modes": [
    "pending",
    "greenfield",
    "brownfield",
    "not_applicable"
  ],
  "modules": {
    "project_state": {
      "default": true,
      "depends_on": []
    },
    "collaboration_gate": {
      "default": false,
      "depends_on": [
        "project_state"
      ]
    },
    "change_review": {
      "default": false,
      "depends_on": []
    }
  },
  "project_assets": [
    {
      "id": "help_docs_index",
      "path": "docs/help/README.md",
      "template": "templates/project-docs/help/README.md",
      "module": "project_state",
      "project_modes": ["greenfield", "brownfield"],
      "since_skill_version": "5.0.2",
      "purpose": "product help and usage manual index"
    },
    {
      "id": "design_docs_index",
      "path": "docs/design/README.md",
      "template": "templates/project-docs/design/README.md",
      "module": "project_state",
      "project_modes": ["greenfield", "brownfield"],
      "since_skill_version": "5.0.2",
      "purpose": "feature, interaction, state-transition, and business-flow design index"
    }
  ],
