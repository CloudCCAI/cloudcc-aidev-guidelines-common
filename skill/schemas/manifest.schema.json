{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CloudCCAI/cloudcc-aidev-guidelines-common/skill/schemas/manifest.schema.json",
  "title": "cc-aidev project manifest v5",
  "type": "object",
  "required": [
    "schema_version",
    "skill_version",
    "project_mode",
    "initialization",
    "modules",
    "module_config",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "skill_version": {
      "type": "string",
      "pattern": "^[0-9]\\.[0-9]\\.[0-9]$"
    },
    "language": {
      "enum": ["pending", "en", "zh-CN"]
    },
    "project_mode": {
      "enum": ["pending", "greenfield", "brownfield", "not_applicable"]
    },
    "initialization": {
      "type": "object",
      "required": ["status", "started_at", "completed_at", "confirmed_by"],
      "properties": {
        "status": {
          "enum": ["in_progress", "ready", "needs_review"]
        },
        "started_at": {
          "$ref": "#/$defs/timestampOrNone"
        },
        "completed_at": {
          "$ref": "#/$defs/timestampOrNone"
        },
        "confirmed_by": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "object",
      "required": ["project_state", "collaboration_gate", "change_review"],
      "properties": {
        "project_state": {"type": "boolean"},
        "collaboration_gate": {"type": "boolean"},
        "change_review": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "module_config": {
      "type": "object",
      "required": ["collaboration_gate", "change_review"],
      "properties": {
        "collaboration_gate": {
          "$ref": "#/$defs/pathOrNone"
        },
        "change_review": {
          "$ref": "#/$defs/pathOrNone"
        }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "legacy_documents_allowed",
        "legacy_index_path",
        "new_document_policy_version",
        "policy_effective_at"
      ],
      "properties": {
        "legacy_documents_allowed": {"type": "boolean"},
        "legacy_index_path": {
          "$ref": "#/$defs/pathOrNone"
        },
        "new_document_policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_effective_at": {
          "$ref": "#/$defs/timestampOrNone"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "skill_version": {
            "pattern": "^(?:5\\.0\\.[1-9]|5\\.[1-9]\\.[0-9]|[6-9]\\.[0-9]\\.[0-9])$"
          }
        },
        "required": ["skill_version"]
      },
      "then": {
        "required": ["language"],
        "properties": {
          "compatibility": {
            "properties": {
              "new_document_policy_version": {"minimum": 3}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill_version": {
            "pattern": "^(?:5\\.0\\.[3-9]|5\\.[1-9]\\.[0-9]|[6-9]\\.[0-9]\\.[0-9])$"
          }
        },
        "required": ["skill_version"]
      },
      "then": {
        "required": ["language"],
        "properties": {
          "language": {"const": "zh-CN"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "initialization": {
            "properties": {
              "status": {"const": "ready"}
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "language": {"not": {"const": "pending"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "modules": {
            "properties": {
              "collaboration_gate": {"const": true}
            },
            "required": ["collaboration_gate"]
          }
        }
      },
      "then": {
        "properties": {
          "modules": {
            "properties": {
              "project_state": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "modules": {
            "properties": {
              "project_state": {"const": false}
            },
            "required": ["project_state"]
          }
        }
      },
      "then": {
        "properties": {
          "project_mode": {"const": "not_applicable"}
        }
      },
      "else": {
        "properties": {
          "project_mode": {"enum": ["pending", "greenfield", "brownfield"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "modules": {
            "properties": {
              "collaboration_gate": {"const": true}
            },
            "required": ["collaboration_gate"]
          }
        }
      },
      "then": {
        "properties": {
          "module_config": {
            "properties": {
              "collaboration_gate": {
                "type": "string",
                "not": {"enum": ["none", "n/a", ""]}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "modules": {
            "properties": {
              "change_review": {"const": true}
            },
            "required": ["change_review"]
          }
        }
      },
      "then": {
        "properties": {
          "module_config": {
            "properties": {
              "change_review": {
                "type": "string",
                "not": {"enum": ["none", "n/a", ""]}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "initialization": {
            "properties": {
              "status": {"const": "ready"}
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "project_mode": {"not": {"const": "pending"}},
          "initialization": {
            "properties": {
              "completed_at": {"$ref": "#/$defs/timestamp"},
              "confirmed_by": {
                "type": "string",
                "minLength": 1,
                "not": {"enum": ["none", "n/a", "null"]}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "timestampOrNone": {
      "oneOf": [
        {"$ref": "#/$defs/timestamp"},
        {"const": "none"},
        {"type": "null"}
      ]
    },
    "pathOrNone": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": true
}
