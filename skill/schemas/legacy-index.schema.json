{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CloudCCAI/cloudcc-aidev-guidelines-common/skill/schemas/legacy-index.schema.json",
  "title": "cc-aidev legacy document index",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "captured_at",
    "policy_effective_at",
    "documents"
  ],
  "properties": {
    "kind": {
      "const": "legacy-document-index"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "captured_at": {
      "$ref": "#/$defs/timestamp"
    },
    "policy_effective_at": {
      "$ref": "#/$defs/timestamp"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": ["string", "null"]
          },
          "schema_version": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          }
        },
        "additionalProperties": true
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "additionalProperties": true
}
